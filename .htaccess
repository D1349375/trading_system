# 開啟 Apache 的網址重寫引擎
RewriteEngine On

# ----------------------------------------------------
# 規則一：隱藏所有的 .php 副檔名
# 例如：輸入 /login 會自動去讀取 login.php 的內容
# ----------------------------------------------------
# 如果請求的不是一個實體目錄
RewriteCond %{REQUEST_FILENAME} !-d
# 如果請求的加上 .php 後是一個實體檔案
RewriteCond %{REQUEST_FILENAME}.php -f
# 就把請求默默導向該 .php 檔案
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ----------------------------------------------------
# 規則二：讓首頁的搜尋功能變成漂亮的網址 (選配進階加分)
# 例如：輸入 /search/btc 會默默導向 index.php?search=btc
# ----------------------------------------------------
RewriteRule ^search/([a-zA-Z0-9_-]+)$ index.php?search=$1 [NC,L]